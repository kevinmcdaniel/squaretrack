# SquareTrack environment variables
#
# Copy this file to `.env` at repo root and fill in real values where noted.
# Every service in docker-compose.yml mounts .env via env_file, so each var
# below is available inside every container regardless of which service uses it.
# Image-internal names (DATABASE_URL, POSTGRES_*, PGPORT, PORT) are remapped
# from these inside docker-compose.yml — do not set them here.

# ──────────────── Database ────────────────

# Postgres listen ports
DB_PORT_INT=5432                        # container-side
DB_PORT_EXT=5004                        # host-side (psql / external clients)

# Application database + role. The Postgres image creates this user/db on
# first run from POSTGRES_USER / POSTGRES_DB / POSTGRES_PASSWORD (mapped in
# docker-compose.yml). DB_SQUARETRACK_URL must use the same password.
DB_SQUARETRACK_NAME=squaretrack
DB_SQUARETRACK_USER=squaretrack
DB_SQUARETRACK_PW=change-me             # secret
# Password embedded in the URL must match DB_SQUARETRACK_PW.
DB_SQUARETRACK_URL="postgresql://squaretrack:change-me@square.db:5432/squaretrack?schema=public"

# ──────────────── Backend ────────────────

BE_PORT_INT=3000                        # container-side BE port
BE_PORT_EXT=5002                        # host-side BE port (curl / Postman target)
BE_URL=http://square.be                 # docker network DNS name; how FE reaches BE

# TODO: BE_KEY is reserved for the api-key auth path that authorizeUser will
# enforce once the stubbed implementation in be/src/common/authorize.ts is
# wired up. No code reads it yet.
BE_KEY=change-me                        # secret (when activated)

# ──────────────── Frontend ────────────────

FE_PORT_INT=4000                        # container-side FE port
FE_PORT_EXT=5001                        # host-side FE port (browser target)

# Circuit breaker tunables (fe/src/lib/hac/fetch.ts)
BE_TIMEOUT_MS=3000                      # per-request timeout for FE→BE fetch
BE_BREAKER_THRESHOLD=3                  # consecutive failures before circuit opens
BE_BREAKER_COOLDOWN_MS=15000            # cool-off window before probe attempt

# ──────────────── Prisma Studio ────────────────

STUDIO_PORT_INT=5555                    # container-side Studio port
STUDIO_PORT_EXT=5003                    # host-side Studio port (browser target)

# ──────────────── pgAdmin (optional) ────────────────
# Only used when starting under the `admin` profile:
#   docker compose --profile admin up

PGADMIN_EMAIL=admin@example.com         # pgAdmin login email
PGADMIN_PW=change-me                    # secret
PGADMIN_PORT=5005                       # host-side pgAdmin port
