// Calls and Programs

model call {
  callId           Int                 @id @default(autoincrement())
  name             String              @unique
  tamSeq           String?             // Taminations call identifier
  sdSeq            String?             // SD program call identifier
  preferredDisplay String?             // caller's preferred name; falls back to name
  // Gender / wave-rule / scale metadata. Nullable until a Callerlab-definition
  // data-entry pass fills them; not present in the Taminations source.
  isPositional     Boolean?            // executable from position + facing alone, no gender needed
  isGenderCall     Boolean?            // definition explicitly references boys / girls
  waveRuleApplies  Boolean?            // wave rule adjusts who-does-what when starting from a wave
  dancerCount      Int?                // atomic definition unit: fewest dancers the call is defined for
  familyId         Int?
  callFamily       call_family?        @relation(fields: [familyId], references: [familyId])
  formations       call_formation[]
  synonyms         call_synonym[]
  teachEntries     teach_order_entry[]
}

model call_family {
  familyId    Int                 @id @default(autoincrement())
  name        String
  calls       call[]
  teachEntries teach_order_entry[]
}

// Alternate names for a call used when parsing pasted sequence text.
model call_synonym {
  id     Int    @id @default(autoincrement())
  callId Int
  call   call   @relation(fields: [callId], references: [callId])
  alias  String @unique
}

// A call executed from a specific starting formation, producing a specific ending formation.
// The (callId, startId) pair is the atomic unit placed in teach orders and sequence steps.
// Flow fields describe directional momentum entering and exiting the call.
// Flow compatibility rules are enforced in the service layer, not here.
model call_formation {
  callId                Int
  call                  call                @relation(fields: [callId], references: [callId])
  startId               Int
  startForm             formation           @relation(name: "startFormation", fields: [startId], references: [formId])
  endId                 Int
  endForm               formation           @relation(name: "endingFormation", fields: [endId], references: [formId])
  inFlowRotation        String?             // left | right | none
  inFlowDirection       String?             // forward | backward | slideLeft | slideRight
  outFlowRotation       String?             // left | right | none
  outFlowDirection      String?             // forward | backward | slideLeft | slideRight
  // Animation difficulty as authored by Taminations: 1=easy, 2=medium, 3=hard.
  // Per-FASR (a call from different formations can have different animation difficulty).
  // Distinct from program_call_formation.difficulty (Callerlab Standard Position teach difficulty).
  taminationsDifficulty Int?
  // Beats to execute this call from this start formation. Per-FASR — same call from a
  // different start formation can have a different beat count. Authoritative source:
  // Callerlab program-specific Timing docs (e.g. Plus-Timing-21-11-03). Taminations
  // animations are a fallback approximation when no Callerlab document exists yet.
  timing                Int?
  programEntries        program_call_formation[]
  teachFasrEntries      teach_order_entry_fasr[]
  sequenceSteps         sequence_calls[]
  choreoSteps           choreo_module_step[]
  @@id([callId, startId])
  @@index([startId])
  @@index([endId])
}

model formation {
  formId      Int              @id @default(autoincrement())
  name        String
  description String?
  clCode      String?
  sdCode      String?
  dancerCount Int?             // 1 | 2 | 4 | 8; null = not yet assigned
  callStart       call_formation[] @relation(name: "startFormation")
  callEnding      call_formation[] @relation(name: "endingFormation")
  sequenceStarts  sequence[]
  moduleStarts    choreo_module[]  @relation(name: "moduleStart")
  moduleEnds      choreo_module[]  @relation(name: "moduleEnd")
}

model program {
  programId             Int                      @id @default(autoincrement())
  name                  String
  abbreviation          String                   @unique  // e.g. ms26, plus, a1
  order                 Int
  isActive              Boolean                  @default(true)  // hide superseded programs.
  dancers               dance_program[]
  teachOrders           teach_order[]
  programCallFormations program_call_formation[]
}

// Defines which call_formations are valid within a program and how difficult each is at that level.
// Difficulty is program-relative: a FASR that is 'challenging' in Mainstream is 'easy' in Plus.
model program_call_formation {
  programId     Int
  program       program        @relation(fields: [programId], references: [programId])
  callId        Int
  startId       Int
  callFormation call_formation @relation(fields: [callId, startId], references: [callId, startId])
  // Callerlab Standard Position difficulty for this (call, FASR) at this program level.
  // Distinct from call_formation.taminationsDifficulty (Taminations animation difficulty, 1-3).
  difficulty    String         // easy | hard | challenging

  @@id([programId, callId, startId])
  @@index([programId, difficulty])
}

// A named ordering of call_formation entries within a program.
// Different callers or updated curricula produce different teach orders for the same program.
model teach_order {
  id        Int                 @id @default(autoincrement())
  programId Int
  program   program             @relation(fields: [programId], references: [programId])
  name      String
  source    String?
  notes     String?
  entries   teach_order_entry[]
  sequences sequence[]
  choreoModules choreo_module[]
}

// Display row for a curriculum slot in a teach order. Mirrors what the caller sees in the
// curriculum list — one row per Callerlab numbered/lettered position. Per-FASR rows live in
// teach_order_entry_fasr; siblings sharing the same family appear as separate rows whose
// displayOrder shares a numeric prefix (e.g. '1', '1a', '1b').
model teach_order_entry {
  teachOrderId Int
  teachOrder   teach_order              @relation(fields: [teachOrderId], references: [id])
  entryOrder   Int                      // monotonic within the teach order; the canonical sort key
  displayOrder String                   // human label: '1', '1a', '1b', '2', '3a' …
  entryType    String                   // family | call
  label        String?                  // family header text; or display override for call rows
  familyId     Int?                     // set when entryType = family
  callFamily   call_family?             @relation(fields: [familyId], references: [familyId])
  callId       Int?                     // set when entryType = call
  call         call?                    @relation(fields: [callId], references: [callId])
  week         Int?                     // class night introduced; applies to all FASRs of this entry
  fasrs        teach_order_entry_fasr[]

  @@id([teachOrderId, entryOrder])
  @@unique([teachOrderId, displayOrder])
  @@index([teachOrderId, week])
}

// Per-FASR atomic row under a call-typed teach_order_entry. One row per (call, FASR) the caller
// teaches. Ordered by (entryOrder, fasrOrder); that ordering drives safeAfterPosition for sequences.
// Family-typed display entries have no rows here.
model teach_order_entry_fasr {
  teachOrderId  Int
  entryOrder    Int
  fasrOrder     Int
  callId        Int
  startId       Int

  entry         teach_order_entry @relation(fields: [teachOrderId, entryOrder], references: [teachOrderId, entryOrder], onDelete: Cascade)
  callFormation call_formation    @relation(fields: [callId, startId], references: [callId, startId])

  @@id([teachOrderId, entryOrder, fasrOrder])
  @@unique([teachOrderId, entryOrder, callId, startId])
  @@index([callId, startId])
}

model sequence {
  seqId             Int              @id @default(autoincrement())
  name              String           @unique
  startFormationId  Int
  startFormation    formation        @relation(fields: [startFormationId], references: [formId])
  teachOrderId      Int?
  teachOrder        teach_order?     @relation(fields: [teachOrderId], references: [id])
  safeAfterEntryOrder Int?           // max teach_order_entry_fasr.entryOrder across call steps
  safeAfterFasrOrder  Int?           // tiebreaker within entryOrder; together these locate the latest taught FASR used
  activator         String?          // heads | sides — if set, sequence can be swapped at render time
  rating            String?          // excellent | good | acceptable | poor
  notes             String?
  isVerified        Boolean          @default(false)
  sourceText        String?          // raw pasted input, preserved as-is
  variantGroupId    String?          // shared uuid across sequences with identical Taminations output
  isValid           Boolean          @default(false)
  calls             sequence_calls[]
  @@index([variantGroupId])
}

// An ordered entry in a sequence. Not all entries are calls — see type field.
// callId and startId are null for non-call entries.
// Render order: text (override) ?? call.preferredDisplay ?? call.name
// Taminations and SD exports skip all non-call entries.
model sequence_calls {
  seqId         Int
  sequence      sequence        @relation(fields: [seqId], references: [seqId])
  order         Int
  type          String          // call | activator | filler | warning | tip | recovery
  callId        Int?
  startId       Int?
  callFormation call_formation? @relation(fields: [callId, startId], references: [callId, startId])
  designator    String?         // heads | sides | boys | girls | centers | ends | leads | trailers | beaus | belles
  count         Int?            // e.g. 4 for "square thru 4"
  text          String?         // display override for calls; full content for non-call types
  helperText    String?         // caller annotation; never exported to Taminations or SD
  @@id([seqId, order])
}

// ── Two-layer choreo / presentation model (issue #70) ────────────────────────
// choreo_module + choreo_module_step hold the reusable, presentation-free
// choreographic content (what calls, from what formations, in what order).
// presentation + presentation_item + presentation_item_step wrap a module with
// the spoken/cueing layer (filler text, alternate names, contextual warnings).
// The sequence / sequence_calls tables are retained until the editor UIs
// (#18/#19/#20) are rebuilt on this model.

// The reusable choreographic unit. Contains no spoken text.
model choreo_module {
  id                  Int                  @id @default(autoincrement())
  name                String
  startFormId         Int                  // formation the module begins from
  startForm           formation            @relation("moduleStart", fields: [startFormId], references: [formId])
  endFormId           Int                  // formation the module leaves dancers in
  endForm             formation            @relation("moduleEnd", fields: [endFormId], references: [formId])
  inFlowRotation      String?              // flow entering this module
  inFlowDirection     String?
  outFlowRotation     String?              // flow exiting this module
  outFlowDirection    String?
  isValid             Boolean              @default(false)
  isVerified          Boolean              @default(false)
  variantGroupId      String?              // shared UUID for choreo-equivalent modules
  safeAfterEntryOrder Int?                 // latest teach-order position used
  safeAfterFasrOrder  Int?
  teachOrderId        Int?
  teachOrder          teach_order?         @relation(fields: [teachOrderId], references: [id])
  steps               choreo_module_step[]
  presentationItems   presentation_item[]
  @@index([variantGroupId])
}

// One call within a module. No spoken text. Inherent warnings live here.
model choreo_module_step {
  moduleId      Int
  module        choreo_module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order         Int
  callId        Int
  startId       Int
  callFormation call_formation @relation(fields: [callId, startId], references: [callId, startId])
  designator    String?        // heads | sides | centers | ends | leads | trailers | beaus | belles
  count         Int?           // e.g. 4 for "square thru 4"
  // Inherent choreographic warning — true regardless of presentation. Distinct
  // from presentation_item_step.warning (contextual). Set at import or manually.
  warning       String?
  @@id([moduleId, order])
  @@index([callId, startId])
}

// A crafted, speakable sequence. References modules, interleaved with text items.
model presentation {
  id         Int                 @id @default(autoincrement())
  name       String
  source     String?             // taminations | callerlab | personal | <caller name>
  activator  String?             // heads | sides
  rating     String?             // excellent | good | acceptable | poor
  notes      String?
  sourceText String?             // raw pasted input, preserved as-is
  items      presentation_item[]
}

// An ordered slot in a presentation: a module reference or a pure text entry.
model presentation_item {
  id             Int                      @id @default(autoincrement())
  presentationId Int
  presentation   presentation             @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  order          Int                      // position within the presentation
  type           String                   // module_ref | text
  // --- module_ref fields ---
  moduleId       Int?
  module         choreo_module?           @relation(fields: [moduleId], references: [id])
  // --- text fields (activator cue, filler, tip, warning, closer) ---
  text           String?                  // spoken text for text-type items
  textType       String?                  // activator | filler | tip | warning | closer
  steps          presentation_item_step[]
  @@unique([presentationId, order])
}

// Per-step cueing decoration for a module reference. Additive: it never replaces
// the choreographic data, only adds the spoken layer around it.
model presentation_item_step {
  itemId            Int
  item              presentation_item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stepOrder         Int               // matches choreo_module_step.order
  textBefore        String?           // spoken before the call name (e.g. "And now", "Easy")
  textAfter         String?           // spoken after the call (e.g. "nice", "keep moving")
  callNameAlternate String?           // caller's preferred spoken name for this call here
  warning           String?           // contextual warning for this step in this presentation
  helperText        String?           // caller's private note; never shown to dancers
  @@id([itemId, stepOrder])
}
