// Calls and Programs

model call {
  callId           Int              @id @default(autoincrement())
  name             String           @unique
  tamSeq           String?          // Taminations call identifier
  sdSeq            String?          // SD program call identifier
  preferredDisplay String?          // caller's preferred name; falls back to name
  familyId         Int?
  callFamily       call_family?     @relation(fields: [familyId], references: [familyId])
  formations       call_formation[]
  synonyms         call_synonym[]
}

model call_family {
  familyId Int    @id @default(autoincrement())
  name     String
  calls    call[]
}

// Alternate names for a call used when parsing pasted sequence text.
model call_synonym {
  id     Int    @id @default(autoincrement())
  callId Int
  call   call   @relation(fields: [callId], references: [callId])
  alias  String @unique
}

// A call executed from a specific starting formation, producing a specific ending formation.
// The (callId, startId) pair is the atomic unit placed in teach orders and sequence steps.
// Flow fields describe directional momentum entering and exiting the call.
// Flow compatibility rules are enforced in the service layer, not here.
model call_formation {
  callId           Int
  call             call                @relation(fields: [callId], references: [callId])
  startId          Int
  startForm        formation           @relation(name: "startFormation", fields: [startId], references: [formId])
  endId            Int
  endForm          formation           @relation(name: "endingFormation", fields: [endId], references: [formId])
  inFlowRotation   String?             // left | right | none
  inFlowDirection  String?             // forward | backward | slideLeft | slideRight
  outFlowRotation  String?             // left | right | none
  outFlowDirection String?             // forward | backward | slideLeft | slideRight
  programEntries   program_call_formation[]
  teachEntries     teach_order_entry[]
  sequenceSteps    sequence_calls[]
  @@id([callId, startId])
  @@index([startId])
  @@index([endId])
}

model formation {
  formId      Int              @id @default(autoincrement())
  name        String
  description String?
  clCode      String?
  sdCode      String?
  callStart       call_formation[] @relation(name: "startFormation")
  callEnding      call_formation[] @relation(name: "endingFormation")
  sequenceStarts  sequence[]
}

model program {
  programId             Int                      @id @default(autoincrement())
  name                  String
  abbreviation          String                   @unique  // e.g. ms26, plus, a1
  order                 Int
  dancers               dance_program[]
  teachOrders           teach_order[]
  programCallFormations program_call_formation[]
}

// Defines which call_formations are valid within a program and how difficult each is at that level.
// Difficulty is program-relative: a FASR that is 'challenging' in Mainstream is 'easy' in Plus.
model program_call_formation {
  programId     Int
  program       program        @relation(fields: [programId], references: [programId])
  callId        Int
  startId       Int
  callFormation call_formation @relation(fields: [callId, startId], references: [callId, startId])
  difficulty    String         // easy | hard | challenging

  @@id([programId, callId, startId])
  @@index([programId, difficulty])
}

// A named ordering of call_formation entries within a program.
// Different callers or updated curricula produce different teach orders for the same program.
model teach_order {
  id        Int                 @id @default(autoincrement())
  programId Int
  program   program             @relation(fields: [programId], references: [programId])
  name      String
  entries   teach_order_entry[]
  sequences sequence[]
}

// One row per (call, FASR) pair introduced in this teach order.
// The same call appears multiple times if valid from multiple starting formations
// introduced at different points. Family header rows have entryType='family',
// null callId and startId.
model teach_order_entry {
  id            Int             @id @default(autoincrement())
  teachOrderId  Int
  teachOrder    teach_order     @relation(fields: [teachOrderId], references: [id])
  sortOrder     Int             // teaching sequence; unique per teach order; drives safeAfterPosition
  position      Int             // Callerlab curriculum number
  subPosition   String?         // Callerlab sub-letter ('a'–'e'); null for top-level entries
  entryType     String          // family | call
  label         String?         // family header text; or display override for call rows
  callId        Int?            // null when entryType = family
  startId       Int?            // null when entryType = family
  callFormation call_formation? @relation(fields: [callId, startId], references: [callId, startId])
  week          Int?            // class night introduced; nullable until scheduled

  @@unique([teachOrderId, sortOrder])
  @@unique([teachOrderId, callId, startId])
  @@index([teachOrderId, position, subPosition])
  @@index([teachOrderId, week])
}

model sequence {
  seqId             Int              @id @default(autoincrement())
  name              String           @unique
  startFormationId  Int
  startFormation    formation        @relation(fields: [startFormationId], references: [formId])
  teachOrderId      Int?
  teachOrder        teach_order?     @relation(fields: [teachOrderId], references: [id])
  safeAfterPosition Int?             // max teach_order_entry.position across all call steps; computed on save
  activator         String?          // heads | sides — if set, sequence can be swapped at render time
  rating            String?          // excellent | good | acceptable | poor
  notes             String?
  isVerified        Boolean          @default(false)
  sourceText        String?          // raw pasted input, preserved as-is
  variantGroupId    String?          // shared uuid across sequences with identical Taminations output
  isValid           Boolean          @default(false)
  calls             sequence_calls[]
  @@index([variantGroupId])
}

// An ordered entry in a sequence. Not all entries are calls — see type field.
// callId and startId are null for non-call entries.
// Render order: text (override) ?? call.preferredDisplay ?? call.name
// Taminations and SD exports skip all non-call entries.
model sequence_calls {
  seqId         Int
  sequence      sequence        @relation(fields: [seqId], references: [seqId])
  order         Int
  type          String          // call | activator | filler | warning | tip | recovery
  callId        Int?
  startId       Int?
  callFormation call_formation? @relation(fields: [callId, startId], references: [callId, startId])
  designator    String?         // heads | sides | boys | girls | centers | ends | leads | trailers | beaus | belles
  count         Int?            // e.g. 4 for "square thru 4"
  text          String?         // display override for calls; full content for non-call types
  helperText    String?         // caller annotation; never exported to Taminations or SD
  @@id([seqId, order])
}
